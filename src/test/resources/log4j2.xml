<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <PlatformLogLevelFilter/>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%date{HH:mm:ss.SSS} [%blue{%thread}] %highlight{%-5level} %logger{36} %cyan{%marker} - %msg%n"
                    disableAnsi="false"
            />
        </Console>
    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>

        <Logger name="ru.itmo.infrastructure.TestEngine" level="DEBUG"/>
    </Loggers>
</Configuration>
