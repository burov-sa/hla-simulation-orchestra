;&quot;&gt;(Для&lt;br&gt;  отладки/мониторинга)&lt;/span&gt;&lt;span style=&quot;font-family:&amp;quot;Calibri&amp;quot;,sans-serif&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;  &lt;/td&gt; &lt;/tr&gt; &lt;tr style=&quot;mso-yfti-irow:6;mso-yfti-lastrow:yes&quot;&gt;  &lt;td style=&quot;border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; border-image: none; padding: 7.5pt 4.25pt;&quot;&gt;&lt;br&gt;  &lt;p class=&quot;MsoNormal&quot; style=&quot;margin-bottom:0cm;line-height:normal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-family: Calibri, sans-serif; color: black;&quot;&gt;model-{id}-inbox&amp;nbsp;(персональный)&lt;/span&gt;&lt;/b&gt;&lt;b&gt;&lt;span style=&quot;font-family:&amp;quot;Calibri&amp;quot;,sans-serif&quot;&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;br&gt;  &lt;/td&gt;  &lt;td style=&quot;border-top-width: medium; border-top-style: none; border-top-color: currentcolor; border-left-width: medium; border-left-style: none; border-left-color: currentcolor; border-bottom: 1pt solid windowtext;&quot;&gt;&lt;br&gt;  &lt;p class=&quot;MsoNormal&quot; style=&quot;margin-bottom:0cm;line-height:normal&quot;&gt;&lt;span style=&quot;font-family: Calibri, sans-serif; color: black;&quot;&gt;Оркестратор&lt;br&gt;  (при получении&amp;nbsp;ONLINE&amp;nbsp;от модели)&lt;/span&gt;&lt;span style=&quot;font-family:&amp;lt;br/&amp;gt;  &amp;quot;Calibri&amp;quot;,sans-serif&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;  &lt;/td&gt;  &lt;td width=&quot;385&quot; style=&quot;width: 288.9pt; border-top-width: medium; border-top-style: none; border-top-color: currentcolor; border-left-width: medium; border-left-style: none; border-left-color: currentcolor; border-right: 1pt solid windowtext; padding: 7.5pt 4.25pt;&quot;&gt;&lt;br&gt;  &lt;p class=&quot;MsoNormal&quot; style=&quot;margin-bottom:0cm;line-height:normal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-family: Calibri, sans-serif; color: black;&quot;&gt;Входящие&lt;br&gt;  агенты для конкретной модели&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-family:&amp;quot;Calibri&amp;quot;,sans-serif;&amp;lt;br/&amp;gt;  color:black;mso-color-alt:windowtext&quot;&gt;: оркестратор пересылает сюда&lt;br&gt;  сообщения&amp;nbsp;AGENT_TRANSFER, адресованные этой модели.&lt;/span&gt;&lt;span style=&quot;font-family:&amp;quot;Calibri&amp;quot;,sans-serif&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;  &lt;/td&gt;  &lt;td width=&quot;50&quot; style=&quot;width: 37.3pt; border-top-width: medium; border-top-style: none; border-top-color: currentcolor; border-left-width: medium; border-left-style: none; border-left-color: currentcolor; border-right: 1pt solid windowtext; padding: 7.5pt 4.25pt;&quot;&gt;&lt;br&gt;  &lt;p class=&quot;MsoNormal&quot; style=&quot;margin-bottom:0cm;line-height:normal&quot;&gt;&lt;span style=&quot;font-family: Calibri, sans-serif; color: black;&quot;&gt;Оркестратор&lt;/span&gt;&lt;span style=&quot;font-family:&amp;quot;Calibri&amp;quot;,sans-serif&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;  &lt;/td&gt;  &lt;td style=&quot;border-top-width: medium; border-top-style: none; border-top-color: currentcolor; border-left-width: medium; border-left-style: none; border-left-color: currentcolor; border-bottom: 1pt solid windowtext;&quot;&gt;&lt;br&gt;  &lt;p class=&quot;MsoNormal&quot; style=&quot;margin-bottom:0cm;line-height:normal&quot;&gt;&lt;span style=&quot;font-family: Calibri, sans-serif; color: black;&quot;&gt;Модель&lt;br&gt;  с соответствующим&amp;nbsp;id&lt;/span&gt;&lt;span style=&quot;font-family:&amp;quot;Calibri&amp;quot;,sans-serif&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;  &lt;/td&gt; &lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
