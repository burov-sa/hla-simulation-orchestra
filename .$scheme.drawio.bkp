        <mxCell id="prNLp_4kxbfP0O4Uhr9g-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;MsoNormal&quot; align=&quot;center&quot; style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;span style=&quot;line-height: 115%;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Схема&lt;br&gt;обмена сообщениями&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;br&gt;&lt;br&gt;&lt;ol style=&quot;margin-top:0cm&quot; start=&quot;1&quot; type=&quot;1&quot;&gt;&lt;br&gt; &lt;li class=&quot;MsoNormal&quot; style=&quot;mso-list:l0 level1 lfo1;tab-stops:list 36.0pt&quot;&gt;&lt;b&gt;Модель → Оркестратор&lt;/b&gt;&amp;nbsp;(через&amp;nbsp;orchestrator-inbox):&lt;/li&gt;&lt;br&gt; &lt;ul style=&quot;margin-top:0cm&quot; type=&quot;circle&quot;&gt;&lt;br&gt;  &lt;li class=&quot;MsoNormal&quot; style=&quot;mso-list:l0 level2 lfo1;tab-stops:list 72.0pt&quot;&gt;STEP_COMPLETED&amp;nbsp;— сигнал о завершении шага.&lt;/li&gt;&lt;br&gt;  &lt;li class=&quot;MsoNormal&quot; style=&quot;mso-list:l0 level2 lfo1;tab-stops:list 72.0pt&quot;&gt;AGENT_TRANSFER&amp;nbsp;— запрос на отправку агента другой модели.&lt;/li&gt;&lt;br&gt; &lt;/ul&gt;&lt;br&gt; &lt;li class=&quot;MsoNormal&quot; style=&quot;mso-list:l0 level1 lfo1;tab-stops:list 36.0pt&quot;&gt;&lt;b&gt;Модель → Оркестратор&lt;/b&gt;&amp;nbsp;(через&amp;nbsp;model-registry):&lt;/li&gt;&lt;br&gt; &lt;ul style=&quot;margin-top:0cm&quot; type=&quot;circle&quot;&gt;&lt;br&gt;  &lt;li class=&quot;MsoNormal&quot; style=&quot;mso-list:l0 level2 lfo1;tab-stops:list 72.0pt&quot;&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;&quot;&gt;{&quot;modelId&quot;:&quot;A&quot;,&quot;inboxTopic&quot;:&quot;model-A-inbox&quot;,&quot;status&quot;:&quot;ONLINE&quot;}&amp;nbsp;—&amp;nbsp;&lt;/span&gt;регистрация&lt;span lang=&quot;EN-US&quot; style=&quot;&quot;&gt;.&lt;/span&gt;&lt;/li&gt;&lt;br&gt;  &lt;li class=&quot;MsoNormal&quot; style=&quot;mso-list:l0 level2 lfo1;tab-stops:list 72.0pt&quot;&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;&quot;&gt;{&quot;modelId&quot;:&quot;A&quot;,&quot;status&quot;:&quot;OFFLINE&quot;}&amp;nbsp;—&amp;nbsp;&lt;/span&gt;отключение&lt;span lang=&quot;EN-US&quot; style=&quot;&quot;&gt;.&lt;/span&gt;&lt;/li&gt;&lt;br&gt; &lt;/ul&gt;&lt;br&gt; &lt;li class=&quot;MsoNormal&quot; style=&quot;mso-list:l0 level1 lfo1;tab-stops:list 36.0pt&quot;&gt;&lt;b&gt;Модель → Оркестратор&lt;/b&gt;&amp;nbsp;(через&amp;nbsp;model-heartbeat):&lt;/li&gt;&lt;br&gt; &lt;ul style=&quot;margin-top:0cm&quot; type=&quot;circle&quot;&gt;&lt;br&gt;  &lt;li class=&quot;MsoNormal&quot; style=&quot;mso-list:l0 level2 lfo1;tab-stops:list 72.0pt&quot;&gt;Просто строка&amp;nbsp;&quot;ModelA&quot;&amp;nbsp;— подтверждение жизни.&lt;/li&gt;&lt;br&gt; &lt;/ul&gt;&lt;br&gt; &lt;li class=&quot;MsoNormal&quot; style=&quot;mso-list:l0 level1 lfo1;tab-stops:list 36.0pt&quot;&gt;&lt;b&gt;Оркестратор → Модель&lt;/b&gt;&amp;nbsp;(через&amp;nbsp;simulation-control):&lt;/li&gt;&lt;br&gt; &lt;ul style=&quot;margin-top:0cm&quot; type=&quot;circle&quot;&gt;&lt;br&gt;  &lt;li class=&quot;MsoNormal&quot; style=&quot;mso-list:l0 level2 lfo1;tab-stops:list 72.0pt&quot;&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;&quot;&gt;{&quot;command&quot;:&quot;NEXT_STEP&quot;,&quot;stepDuration&quot;:1.0}&amp;nbsp;—&amp;nbsp;&lt;/span&gt;команда выполнить шаг&lt;span lang=&quot;EN-US&quot; style=&quot;&quot;&gt;.&lt;/span&gt;&lt;/li&gt;&lt;br&gt; &lt;/ul&gt;&lt;br&gt; &lt;li class=&quot;MsoNormal&quot; style=&quot;mso-list:l0 level1 lfo1;tab-stops:list 36.0pt&quot;&gt;&lt;b&gt;Оркестратор → Модель&lt;/b&gt;&amp;nbsp;(через&amp;nbsp;model-A-inbox):&lt;/li&gt;&lt;br&gt; &lt;ul style=&quot;margin-top:0cm&quot; type=&quot;circle&quot;&gt;&lt;br&gt;  &lt;li class=&quot;MsoNormal&quot; style=&quot;mso-list:l0 level2 lfo1;tab-stops:list 72.0pt&quot;&gt;Protobuf-сообщение&amp;nbsp;OrchestratorMessage&amp;nbsp;с типом&amp;nbsp;AGENT_TRANSFER &lt;br&gt;и&amp;nbsp;payload&amp;nbsp;— сериализованный&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;агент.&lt;/span&gt;&lt;/li&gt;&lt;br&gt; &lt;/ul&gt;&lt;br&gt;&lt;/ol&gt;" vertex="1">
